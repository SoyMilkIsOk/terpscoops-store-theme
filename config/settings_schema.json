  {
    "name": "Typography",
    "settings": [
      {
        "type": "select",
        "id": "display_font",
        "label": "Display / Heading Font",
        "options": [
          {
            "value": "plus_jakarta",
            "label": "Plus Jakarta Sans (Clean Humanist Aero)"
          },
          {
            "value": "poetsen_one",
            "label": "Poetsen One (Playful Rounded Terpscoops Classic)"
          }
        ],
        "default": "plus_jakarta"
      },
      {
        "type": "range",
        "id": "heading_font_scale",
        "label": "Heading Font Scale",
        "min": 85,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_font_scale",
        "label": "Body Font Scale",
        "min": 90,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Aero Glass & Visual Effects",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_aero_bubbles",
        "label": "Enable ambient floating Aero bubbles & bokeh",
        "default": true
      },
      {
        "type": "range",
        "id": "glass_blur_px",
        "label": "Frosted Glass Blur Intensity",
        "min": 8,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "gel_gloss_intensity",
        "label": "Aqua Gel Gloss Intensity",
        "min": 30,
        "max": 100,
        "step": 10,
        "unit": "%",
        "default": 80
      }
    ]
  },
  {
    "name": "Native Age Verification (21+)",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_age_gate",
        "label": "Enable native Aero Glass 21+ age gate",
        "info": "Replaces third-party AgeChecker Plus blocking scripts with a zero-dependency modal.",
        "default": true
      },
      {
        "type": "number",
        "id": "age_gate_min_age",
        "label": "Minimum Legal Age",
        "default": 21
      },
      {
        "type": "text",
        "id": "age_gate_heading",
        "label": "Modal Heading",
        "default": "Are you 21+?"
      },
      {
        "type": "textarea",
        "id": "age_gate_subtext",
        "label": "Modal Description",
        "default": "You must be 21 or older to enter."
      },
      {
        "type": "text",
        "id": "age_gate_button_label",
        "label": "Confirm Button Label",
        "default": "Yes, I'm 21+"
      },
      {
        "type": "text",
        "id": "age_gate_exit_label",
        "label": "Exit Button Label",
        "default": "Exit"
      },
      {
        "type": "url",
        "id": "age_gate_exit_url",
        "label": "Exit Redirect URL"
      },
      {
        "type": "range",
        "id": "age_gate_ttl_days",
        "label": "Remember Verification (Days)",
        "min": 1,
        "max": 90,
        "step": 1,
        "unit": "d",
        "default": 30
      }
    ]
  },
  {
    "name": "Cart Drawer & Pack Upsell",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
        "label": "Enable Aero Glass slide-out cart drawer",
        "default": true
      },
      {
        "type": "number",
        "id": "cart_free_shipping_threshold",
        "label": "Free Shipping Goal ($ USD)",
        "default": 35
      },
      {
        "type": "product",
        "id": "cart_upsell_product",
        "label": "Cart Impulse Upsell Product (e.g., Terpscoop 2pk)"
      }
    ]
  },
