<footer class="aero-footer" role="contentinfo">
  <div class="page-width">
    <div class="aero-glass aero-footer__panel">
      <div class="aero-footer__grid">
        <div>
          <div class="aero-header__brand" style="margin-bottom:0.85rem;">
            <img
              src="{{ 'terpmetrix-rainbow-logo.png' | asset_url }}"
              alt="{{ shop.name | escape }}"
              width="38"
              height="38"
              class="aero-header__logo-mark"
            >
            <span>{{ shop.name }}</span>
          </div>
          <p class="aero-muted" style="font-size:0.92rem;max-width:34ch;">
            {{ section.settings.brand_blurb }}
          </p>
          <div class="aero-badge-strip" style="margin-top:0.75rem;">
            <span class="aero-pill aero-pill--green">
              {% render 'aero-icon', icon: 'mountain' %}
              {{ settings.origin_city | default: 'Boulder, CO' }}
            </span>
            <a
              href="{{ settings.social_instagram_link | default: 'https://instagram.com/terpscoops' }}"
              target="_blank"
              rel="noopener"
              class="aero-pill aero-pill--sky"
            >
              {% render 'aero-icon', icon: 'instagram' %}
              {{ settings.social_instagram_handle | default: '@terpscoops' }}
            </a>
          </div>
        </div>

        <div>
          <h4 style="margin-bottom:0.75rem;">Shop</h4>
          <ul class="aero-footer__links">
            <li><a href="{{ routes.all_products_collection_url }}">Shop All</a></li>
            <li><a href="{{ routes.collections_url }}/color-scoops">Color Scoops</a></li>
            <li><a href="{{ routes.collections_url }}/metal-scoops">Metal Scoops</a></li>
            <li><a href="{{ routes.collections_url }}/merch">Merch</a></li>
          </ul>
        </div>

        <div>
          <h4 style="margin-bottom:0.75rem;">Info</h4>
          <ul class="aero-footer__links">
            {%- assign wholesale_fallback = routes.collections_url | append: '/frontpage' -%}
            {%- assign wholesale_url = pages['wholesale'].url | default: wholesale_fallback -%}
            <li><a href="{{ wholesale_url }}">Wholesale</a></li>
            <li><a href="/pages/about-us">Our Story</a></li>
            <li><a href="/pages/contact">Contact</a></li>
          </ul>
        </div>

        <div>
          <h4 style="margin-bottom:0.75rem;">Stay in the Loop</h4>
          <p class="aero-muted" style="font-size:0.86rem;">
            Sign up for new drops, restocks, and giveaways.
          </p>
          {% form 'customer', id: 'AeroFooterNewsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <div class="aero-form-alert aero-form-alert--success">
                Thanks for subscribing!
              </div>
            {%- endif -%}
            <div style="display:flex;gap:0.45rem;flex-wrap:wrap;">
              <input
                type="email"
                name="contact[email]"
                class="aero-input"
                placeholder="you@domain.com"
                required
                aria-label="Email address"
                style="flex:1;min-width:160px;"
              >
              <button type="submit" class="btn-aero-gel btn-aero-gel--sm">Subscribe</button>
            </div>
          {% endform %}
        </div>
      </div>

      <div class="aero-footer__bottom">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · A Terpmetrix Brand. Hand-packed in {{ settings.origin_city | default: 'Boulder, CO' }}.</span>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <a href="{{ policy.url }}">{{ policy.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Aero Horizon Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "brand_blurb",
      "label": "Brand description",
      "default": "Home of the world's best grinder scoop. Designed and bagged in Boulder, CO."
    }
  ]
}
{% endschema %}

