<footer class="aero-footer" role="contentinfo">
  <div class="page-width">
    <div class="aero-glass aero-footer__panel">
      <div class="aero-footer__grid">
        <div>
          <div class="aero-header__brand" style="margin-bottom:0.85rem;">
            <span class="aero-header__badge-mark">
              {% render 'aero-icon', icon: 'scoop' %}
            </span>
            <span>{{ shop.name }}</span>
          </div>
          <p class="aero-muted" style="font-size:0.92rem;max-width:34ch;">
            {{ section.settings.brand_blurb }}
          </p>
          <div class="aero-badge-strip" style="margin-top:0.75rem;">
            <span class="aero-pill aero-pill--green">
              {% render 'aero-icon', icon: 'mountain' %}
              {{ settings.origin_city | default: 'Boulder, CO' }}
            </span>
            <a
              href="{{ settings.social_instagram_link | default: 'https://instagram.com/terpscoops' }}"
              target="_blank"
              rel="noopener"
              class="aero-pill aero-pill--sky"
            >
              {% render 'aero-icon', icon: 'instagram' %}
              {{ settings.social_instagram_handle | default: '@terpscoops' }}
            </a>
          </div>
        </div>

        <div>
          <h4 style="margin-bottom:0.75rem;">Shop</h4>
          <ul class="aero-footer__links">
            <li><a href="/products/terpscoop-2pk">Terpscoop (2pk) — $4.20</a></li>
            <li><a href="/products/terpscoop-4pk">Terpscoop (4pk) — $8.00</a></li>
            <li><a href="/products/terpscoop-8pk">Terpscoop (8pk) — $15.00</a></li>
            <li><a href="/collections/metal-scoops">Metal Editions (Steel / Ti / Silver)</a></li>
            <li><a href="/collections/merch">Terp Merch &amp; Hats</a></li>
          </ul>
        </div>

        <div>
          <h4 style="margin-bottom:0.75rem;">Wholesale &amp; Brand</h4>
          <ul class="aero-footer__links">
            <li><a href="/products/jar-of-scoops">25ct Display Jar ($40)</a></li>
            <li><a href="/pages/wholesale">Dispensary &amp; Headshop Portal</a></li>
            <li><a href="/pages/about-us">Our Story (Broken 3D Print → Product)</a></li>
            <li><a href="/pages/contact">Contact Support</a></li>
            <li><a href="mailto:{{ settings.wholesale_email | default: 'wholesale@terpscoops.com' }}">{{ settings.wholesale_email | default: 'wholesale@terpscoops.com' }}</a></li>
          </ul>
        </div>

        <div>
          <h4 style="margin-bottom:0.75rem;">Drop List &amp; Restocks</h4>
          <p class="aero-muted" style="font-size:0.86rem;">
            First dibs on Sterling Silver @kevianjewelers casts, Stainless restocks, and Boulder giveaways.
          </p>
          {% form 'customer', id: 'AeroFooterNewsletter' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <div class="aero-form-alert aero-form-alert--success">
                You're on the TerpAero drop list!
              </div>
            {%- endif -%}
            <div style="display:flex;gap:0.45rem;flex-wrap:wrap;">
              <input
                type="email"
                name="contact[email]"
                class="aero-input"
                placeholder="you@domain.com"
                required
                aria-label="Email address"
                style="flex:1;min-width:160px;"
              >
              <button type="submit" class="btn-aero-gel btn-aero-gel--sm">Join</button>
            </div>
          {% endform %}
        </div>
      </div>

      <div class="aero-footer__bottom">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} · A Terpmetrix Brand. Hand-packed in {{ settings.origin_city | default: 'Boulder, CO' }}.</span>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <a href="{{ policy.url }}">{{ policy.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Aero Horizon Footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "brand_blurb",
      "label": "Brand description",
      "default": "Precision pocket grinder tools engineered from one broken 3D print in Boulder, CO. Part of the Terpmetrix family."
    }
  ]
}
{% endschema %}

