<section class="aero-section aero-section--tight" data-hero-showcase>
  <div class="page-width">
    <div class="aero-hero-grid">
      <div class="aero-glass aero-window aero-hero-panel">
        <div class="aero-window__bar">
          <span class="aero-window__dots" aria-hidden="true">
            <span class="aero-window__dot aero-window__dot--cyan"></span>
            <span class="aero-window__dot aero-window__dot--green"></span>
            <span class="aero-window__dot aero-window__dot--pink"></span>
          </span>
        </div>

        <div class="aero-hero-panel__body">
          <h1>{{ section.settings.heading | escape }}</h1>

          <p class="aero-hero-panel__subtitle">
            {{ section.settings.subheading | escape }}
          </p>

          <div class="aero-hero-ctas">
            <a href="{{ section.settings.primary_cta_link | default: routes.all_products_collection_url }}" class="btn-aero-gel">
              <span>{{ section.settings.primary_cta_label | escape }}</span>
              {% render 'aero-icon', icon: 'arrow-right' %}
            </a>
            {%- assign fallback_scoops_url = routes.collections_url | append: '/shop-terpscoops' -%}
            <a href="{{ section.settings.secondary_cta_link | default: fallback_scoops_url }}" class="btn-aero-sky">
              <span>{{ section.settings.secondary_cta_label | escape }}</span>
            </a>
          </div>

          <div class="aero-hero-rating">
            <span class="aero-stars" aria-label="5 out of 5 stars">
              {%- for i in (1..5) -%}
                {% render 'aero-icon', icon: 'star' %}
              {%- endfor -%}
            </span>
            <span>5.0 / 5.0 from 47+ verified reviews</span>
          </div>
        </div>
      </div>

      <div class="aero-glass aero-window aero-hero-stage">
        <div class="aero-window__bar" style="margin:-1.65rem -1.65rem 0;">
          <span class="aero-window__dots" aria-hidden="true">
            <span class="aero-window__dot aero-window__dot--green"></span>
            <span class="aero-window__dot aero-window__dot--cyan"></span>
          </span>
        </div>

        <div class="aero-hero-stage__canvas" data-hero-wheel-stage>
          {%- if section.settings.hero_image != blank -%}
            <img
              src="{{ section.settings.hero_image | image_url: width: 960 }}"
              alt="{{ section.settings.hero_image.alt | default: section.settings.heading | escape }}"
              class="aero-hero-stage__img"
              width="{{ section.settings.hero_image.width }}"
              height="{{ section.settings.hero_image.height }}"
              loading="eager"
            >
          {%- else -%}
            <div class="aero-hero-orb-display">
              <div class="aero-hero-wheel-wrap" data-hero-wheel-wrap>
                <span class="aero-hero-wheel-glow" data-hero-preview-orb style="--resin-color: #60AEDB;"></span>
                <img
                  src="{{ 'terpscoops-wheel-logo.png' | asset_url }}"
                  alt="8 Vibrant Terpscoops Wheel"
                  width="280"
                  height="280"
                  loading="eager"
                  class="aero-hero-wheel-img"
                  data-hero-wheel
                >
              </div>
            </div>
          {%- endif -%}
        </div>

        <div class="aero-hero-color-bar" role="group" aria-label="Preview Terpscoop colors">
          {%- assign colors = 'Pink:#F406B0,Red:#F61F1F,Orange:#FF8A00,Yellow:#FFE500,Green:#05AA3D,Cyan:#60AEDB,Blue:#005BD3,Purple:#A54DCF' | split: ',' -%}
          {%- for entry in colors -%}
            {%- assign parts = entry | split: ':' -%}
            <button
              type="button"
              class="aero-hero-color-btn{% if parts[0] == 'Cyan' %} is-selected{% endif %}"
              data-hero-color-btn
              data-color-name="{{ parts[0] }}"
              data-color-hex="{{ parts[1] }}"
              aria-label="Preview {{ parts[0] }}"
              title="{{ parts[0] }}"
            >
              <span class="swatch-aero-resin" style="--resin-color: {{ parts[1] }};"></span>
            </button>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aero Ritual Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "World's Best Grinder Scoop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Stop pinching your herb. Start scooping."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Always in your grinder & ready to use. No sticky fingers, no mess."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero feature photo"
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Primary button label",
      "default": "Shop All Products"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secondary button label",
      "default": "Shop Terpscoops"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Aero Ritual Hero"
    }
  ]
}
{% endschema %}

