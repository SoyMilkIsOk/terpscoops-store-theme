<section class="aero-section">
  <div class="page-width">
    <div class="aero-section-header">
      <div class="aero-section-header__copy">
        <span class="aero-mono-tag">INJECTION-MOLDED ACRYLIC RESIN</span>
        <h2>{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.subheading | escape }}</p>
      </div>
      <a href="/collections/color-scoops" class="btn-aero-sky btn-aero-gel--sm">
        <span>Shop All Color Scoops</span>
        {% render 'aero-icon', icon: 'arrow-right' %}
      </a>
    </div>

    {%- assign target_collection = collections[section.settings.collection] -%}
    <div class="aero-grid-4">
      {%- if target_collection != blank and target_collection.products_count > 0 -%}
        {%- for product in target_collection.products limit: 4 -%}
          {% render 'product-card-aero', product: product, theme_variant: 'day', show_swatches: true %}
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_handles = 'terpscoop-2pk,terpscoop-4pk,terpscoop-8pk,jar-of-scoops' | split: ',' -%}
        {%- for handle in fallback_handles -%}
          {%- assign prod = all_products[handle] -%}
          {%- if prod != blank and prod.id != blank -%}
            {% render 'product-card-aero', product: prod, theme_variant: 'day', show_swatches: true %}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Color Pack Showcase",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "8 Vibrant Colors. Pick Your Custom Mix."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose a single signature hue or use our interactive Tray Builder on any 2pk ($4.20), 4pk ($8), or 8pk ($15) to hand-pick every scoop in your bag."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "default": "color-scoops"
    }
  ],
  "presets": [
    {
      "name": "Color Pack Showcase"
    }
  ]
}
{% endschema %}

