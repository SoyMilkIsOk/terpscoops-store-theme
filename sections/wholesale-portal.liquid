{%- assign jar_product = all_products['jar-of-scoops'] -%}

<section class="aero-section aero-section--tight">
  <div class="page-width">
    <div class="aero-section-header">
      <div class="aero-section-header__copy">
        <h1>{{ section.settings.heading | escape }}</h1>
        <p>{{ section.settings.subheading | escape }}</p>
      </div>
    </div>

    <div class="aero-grid-2">
      <div class="aero-glass aero-window" data-wholesale-calculator>
        <div class="aero-window__bar">
          <span class="aero-window__dots" aria-hidden="true">
            <span class="aero-window__dot aero-window__dot--cyan"></span>
            <span class="aero-window__dot aero-window__dot--green"></span>
          </span>
          <span class="aero-window__title">25ct Display Jar Margin Calculator</span>
        </div>

        <div style="padding:1.6rem;">
          <div class="aero-field">
            <label for="WholesaleJarCount">
              Display Jars (25 scoops each): <strong data-out-jars>2 Jars</strong>
            </label>
            <input
              id="WholesaleJarCount"
              type="range"
              min="1"
              max="25"
              step="1"
              value="2"
              data-jar-count
              style="width:100%;accent-color:var(--aero-gel-green);"
            >
          </div>

          <div class="aero-field">
            <label for="WholesaleMsrp">Suggested Retail Price per Scoop</label>
            <select id="WholesaleMsrp" class="aero-select" data-retail-msrp>
              <option value="3.50">$3.50 / scoop (High-Volume Impulse)</option>
              <option value="4.20" selected>$4.20 / scoop (Classic Terpscoop Price)</option>
              <option value="5.00">$5.00 / scoop (Dispensary Premium)</option>
            </select>
          </div>

          <div class="aero-calc-metrics">
            <div class="aero-calc-stat">
              <span class="aero-calc-stat__label">Total Scoops</span>
              <span class="aero-calc-stat__val" data-out-scoops>50 Scoops</span>
            </div>
            <div class="aero-calc-stat">
              <span class="aero-calc-stat__label">Your Cost ($1.60/ea)</span>
              <span class="aero-calc-stat__val" data-out-cost>$80.00</span>
            </div>
            <div class="aero-calc-stat">
              <span class="aero-calc-stat__label">Est. Retail Revenue</span>
              <span class="aero-calc-stat__val" data-out-revenue>$210.00</span>
            </div>
            <div class="aero-calc-stat" style="background:linear-gradient(180deg, #DCFFF2 0%, #B8FCE2 100%);">
              <span class="aero-calc-stat__label">Net Shop Profit</span>
              <span class="aero-calc-stat__val" style="color:#03543A;" data-out-profit>+$130.00</span>
            </div>
          </div>

          {%- if jar_product != blank and jar_product.available -%}
            <div style="margin-top:1.25rem;">
              {% form 'product', jar_product, data-ajax-cart-form: 'true' %}
                <input type="hidden" name="id" value="{{ jar_product.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="2" data-wholesale-jar-qty>
                <button type="submit" class="btn-aero-gel btn-aero-gel--full">
                  {% render 'aero-icon', icon: 'cart' %}
                  <span>Add Selected Display Jars to Bag</span>
                </button>
              {% endform %}
            </div>
          {%- else -%}
            <div style="margin-top:1.25rem;">
              <a href="/products/jar-of-scoops" class="btn-aero-gel btn-aero-gel--full">
                View 25ct Display Jar ($40)
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="aero-glass aero-window">
        <div class="aero-window__bar">
          <span class="aero-window__dots" aria-hidden="true">
            <span class="aero-window__dot aero-window__dot--green"></span>
            <span class="aero-window__dot aero-window__dot--pink"></span>
          </span>
          <span class="aero-window__title">Tax-Exempt Wholesale Account</span>
        </div>

        <div style="padding:1.6rem;">
          <h3 style="margin-bottom:0.35rem;">Apply for Tax-Exempt Pricing</h3>
          <p class="aero-muted" style="font-size:0.92rem;">
            Want to avoid sales tax on wholesale jar orders or request bulk case pricing? Submit your shop info below or email <strong>{{ settings.wholesale_email | default: 'wholesale@terpscoops.com' }}</strong> with your resale certificate.
          </p>

          {% form 'contact', id: 'WholesaleInquiryForm' %}
            {%- if form.posted_successfully? -%}
              <div class="aero-form-alert aero-form-alert--success">
                {{ 'wholesale.submit_success' | t }}
              </div>
            {%- elsif form.errors -%}
              <div class="aero-form-alert aero-form-alert--error">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <input type="hidden" name="contact[subject]" value="Tax-Exempt Wholesale Account Inquiry">

            <div class="aero-field">
              <label for="WholesaleShopName">Dispensary / Headshop Name</label>
              <input id="WholesaleShopName" type="text" name="contact[shop_name]" class="aero-input" required>
            </div>

            <div class="aero-field">
              <label for="WholesaleEmail">Buyer Email *</label>
              <input id="WholesaleEmail" type="email" name="contact[email]" class="aero-input" required>
            </div>

            <div class="aero-field">
              <label for="WholesaleLocation">City / State &amp; Resale License #</label>
              <input id="WholesaleLocation" type="text" name="contact[license_info]" class="aero-input" placeholder="e.g., Denver, CO · License #...">
            </div>

            <div class="aero-field">
              <label for="WholesaleNotes">Estimated Jars / Order Details</label>
              <textarea id="WholesaleNotes" name="contact[body]" rows="3" class="aero-textarea" placeholder="Tell us how many 25ct Display Jars or custom colors you're looking for..."></textarea>
            </div>

            <button type="submit" class="btn-aero-sky btn-aero-gel--full">
              Request Tax-Exempt Wholesale Account
            </button>
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wholesale B2B Portal",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stock Terpscoops at Your Dispensary or Headshop."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Each Display Jar holds 25 Terpscoops ($1.60/unit), features an educational comic strip on the jar, giveaway QR callouts, and extra customer stickers."
    }
  ],
  "presets": [
    {
      "name": "Wholesale B2B Portal"
    }
  ]
}
{% endschema %}

