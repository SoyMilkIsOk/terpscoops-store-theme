{% render 'wholesale-portal-content', heading: section.settings.heading, subheading: section.settings.subheading %}

{% schema %}
{
  "name": "Wholesale B2B Portal",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stock Terpscoops at Your Dispensary or Headshop."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Each Display Jar holds 25 Terpscoops, features an educational comic strip on the jar, giveaway QR callouts, and extra customer stickers."
    }
  ],
  "presets": [
    {
      "name": "Wholesale B2B Portal"
    }
  ]
}
{% endschema %}

