      "label": "Gallery photo 1"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_2",
      "label": "Gallery photo 2"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_3",
      "label": "Gallery photo 3"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_4",
      "label": "Gallery photo 4"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_5",
      "label": "Gallery photo 5"
