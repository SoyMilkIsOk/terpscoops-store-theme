{%- liquid
  assign page_handle_lower = page.handle | downcase
  assign has_custom_gallery = false
  if section.blocks.size > 0
    assign has_custom_gallery = true
  else
    for i in (1..8)
      assign img_key = 'gallery_image_' | append: i
      if section.settings[img_key] != blank
        assign has_custom_gallery = true
        break
      endif
    endfor
  endif

  assign is_about_page = false
  if page_handle_lower contains 'about' or page_handle_lower contains 'story' or has_custom_gallery
    assign is_about_page = true
  endif
-%}

{%- if page_handle_lower contains 'wholesale' -%}
  {% render 'wholesale-portal-content' %}
{%- elsif page_handle_lower contains 'contact' -%}
  {% render 'contact-form-content' %}
{%- else -%}
  <section class="aero-section aero-section--tight">
    <div class="page-width">
      {%- if is_about_page -%}
        <div class="aero-about-layout">
          <div class="aero-glass aero-window aero-policy-window aero-about-layout__content">
            <div class="aero-window__bar">
              <span class="aero-window__dots" aria-hidden="true">
                <span class="aero-window__dot aero-window__dot--cyan"></span>
                <span class="aero-window__dot aero-window__dot--green"></span>
                <span class="aero-window__dot aero-window__dot--pink"></span>
              </span>
            </div>
            <div class="aero-policy-window__body">
              <div class="shopify-policy__title">
                <h1>{{ page.title | escape }}</h1>
              </div>
              <div class="aero-rte">
                {{ page.content }}
              </div>
            </div>
          </div>

          <div class="aero-about-layout__gallery">
            {% render 'aero-photo-viewer',
              blocks: section.blocks,
              section_settings: section.settings,
              viewer_mode: 'about',
              autoplay: true
            %}
          </div>
        </div>
      {%- else -%}
        <div class="aero-glass aero-window aero-policy-window">
          <div class="aero-window__bar">
            <span class="aero-window__dots" aria-hidden="true">
              <span class="aero-window__dot aero-window__dot--cyan"></span>
              <span class="aero-window__dot aero-window__dot--green"></span>
              <span class="aero-window__dot aero-window__dot--pink"></span>
            </span>
          </div>
          <div class="aero-policy-window__body">
            <div class="shopify-policy__title">
              <h1>{{ page.title | escape }}</h1>
            </div>
            <div class="aero-rte">
              {{ page.content }}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

