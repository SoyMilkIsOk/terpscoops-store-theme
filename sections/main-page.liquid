<section class="aero-section aero-section--tight">
  <div class="page-width">
    <div class="aero-glass aero-window" style="max-width:920px;margin-inline:auto;">
      <div class="aero-window__bar">
        <span class="aero-window__dots" aria-hidden="true">
          <span class="aero-window__dot aero-window__dot--cyan"></span>
          <span class="aero-window__dot aero-window__dot--green"></span>
        </span>
        <span class="aero-window__title">{{ page.title | escape }}</span>
      </div>
      <div style="padding:clamp(1.5rem, 3.5vw, 2.75rem);">
        <h1>{{ page.title | escape }}</h1>
        <div class="aero-muted" style="font-size:1.02rem;line-height:1.7;">
          {{ page.content }}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aero Standard Page",
  "settings": []
}
{% endschema %}

