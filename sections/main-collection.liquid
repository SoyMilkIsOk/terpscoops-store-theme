{%- liquid
  assign wholesale_fallback = routes.collections_url | append: '/frontpage'
  assign wholesale_url = pages['wholesale'].url | default: wholesale_fallback
-%}

{%- if collection.handle == 'frontpage' or collection.handle == 'wholesale' -%}
  {% render 'wholesale-portal-content' %}
{%- else -%}
  <section class="aero-section aero-section--tight">
    <div class="page-width">
      <div class="aero-glass aero-window" style="padding:1.5rem 1.75rem;margin-bottom:1.75rem;">
        <div style="margin-bottom:1.1rem;">
          <h1 style="margin:0;font-size:clamp(1.75rem, 3.2vw, 2.5rem);">
            {%- if collection.handle == 'all' -%}
              Shop All
            {%- else -%}
              {{ collection.title }}
            {%- endif -%}
          </h1>
          {%- if collection.description != blank -%}
            <div class="aero-muted" style="margin-top:0.4rem;">{{ collection.description }}</div>
          {%- endif -%}
        </div>

        <div class="aero-shop-toolbar">
          <nav class="aero-filter-tabs" aria-label="Filter by category">
            <a
              href="{{ routes.all_products_collection_url }}"
              class="aero-filter-tab{% if collection.handle == 'all' %} is-active{% endif %}"
            >
              <span>All Products</span>
              {%- if collections['all'].products_count > 0 -%}
                <span class="aero-filter-tab__count">{{ collections['all'].products_count }}</span>
              {%- endif -%}
            </a>

            <a
              href="{{ routes.collections_url }}/color-scoops"
              class="aero-filter-tab{% if collection.handle == 'color-scoops' %} is-active{% endif %}"
            >
              <span>Color Scoops</span>
              {%- if collections['color-scoops'].products_count > 0 -%}
                <span class="aero-filter-tab__count">{{ collections['color-scoops'].products_count }}</span>
              {%- endif -%}
            </a>

            <a
              href="{{ routes.collections_url }}/metal-scoops"
              class="aero-filter-tab{% if collection.handle == 'metal-scoops' %} is-active{% endif %}"
            >
              <span>Metal Scoops</span>
              {%- if collections['metal-scoops'].products_count > 0 -%}
                <span class="aero-filter-tab__count">{{ collections['metal-scoops'].products_count }}</span>
              {%- endif -%}
            </a>

            <a
              href="{{ routes.collections_url }}/merch"
              class="aero-filter-tab{% if collection.handle == 'merch' %} is-active{% endif %}"
            >
              <span>Merch</span>
              {%- if collections['merch'].products_count > 0 -%}
                <span class="aero-filter-tab__count">{{ collections['merch'].products_count }}</span>
              {%- endif -%}
            </a>

            <a href="{{ wholesale_url }}" class="aero-filter-tab">
              <span>Wholesale</span>
            </a>
          </nav>

          <div class="aero-shop-toolbar__sort">
            <label for="AeroCollectionSort" class="aero-muted" style="font-size:0.84rem;font-weight:700;">Sort</label>
            <select id="AeroCollectionSort" class="aero-select aero-sort-select" data-collection-sort>
              <option value="featured">Featured</option>
              <option value="price-asc">Price: Low to High</option>
              <option value="price-desc">Price: High to Low</option>
              <option value="title-asc">Title: A–Z</option>
            </select>
          </div>
        </div>
      </div>

      {% paginate collection.products by 48 %}
        {%- if collection.products.size > 0 -%}
          {%- assign ordered_products = collection.products | sort: 'price' -%}
          {%- assign category_passes = 'color,metal,jar,merch' | split: ',' -%}
          {%- assign feat_idx = 0 -%}

          <div class="aero-grid-4" data-collection-grid>
            {%- for pass in category_passes -%}
              {%- for product in ordered_products -%}
                {%- liquid
                  assign h_lower = product.handle | downcase
                  assign prod_cat = 'merch'
                  if h_lower contains '2pk' or h_lower contains '4pk' or h_lower contains '8pk'
                    assign prod_cat = 'color'
                  elsif h_lower contains 'stainless' or h_lower contains 'titanium' or h_lower contains 'silver'
                    assign prod_cat = 'metal'
                  elsif h_lower contains 'jar'
                    assign prod_cat = 'jar'
                  endif
                -%}
                {%- if prod_cat == pass -%}
                  {%- assign feat_idx = feat_idx | plus: 1 -%}
                  <div
                    class="aero-grid-item"
                    data-featured-index="{{ feat_idx }}"
                    data-product-price="{{ product.price }}"
                    data-product-title="{{ product.title | escape }}"
                    data-product-category="{{ prod_cat }}"
                  >
                    {% render 'product-card-aero', product: product, show_swatches: true %}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav style="display:flex;justify-content:center;gap:0.65rem;margin-top:2rem;" aria-label="Pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="btn-aero-ghost btn-aero-gel--sm">Previous</a>
              {%- endif -%}
              <span class="aero-pill aero-pill--sky">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="btn-aero-sky btn-aero-gel--sm">Next</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <div class="aero-glass" style="padding:3rem;text-align:center;">
            <h3>No products found in this collection yet.</h3>
            <a href="{{ routes.all_products_collection_url }}" class="btn-aero-gel btn-aero-gel--sm">Browse All Products</a>
          </div>
        {%- endif -%}
      {% endpaginate %}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Aero Collection Grid",
  "settings": []
}
{% endschema %}

