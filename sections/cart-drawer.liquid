<div id="TerpCartDrawer" class="aero-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}">
  <div class="aero-drawer__backdrop" data-close-cart-drawer></div>
  <div class="aero-drawer__panel aero-glass">
    <div class="aero-window__bar">
      <span class="aero-window__dots" aria-hidden="true">
        <span class="aero-window__dot aero-window__dot--cyan"></span>
        <span class="aero-window__dot aero-window__dot--green"></span>
        <span class="aero-window__dot aero-window__dot--pink"></span>
      </span>
      <span class="aero-window__title">{{ 'cart.title' | t }}</span>
      <button type="button" class="aero-icon-btn" style="width:32px;height:32px;min-width:32px;padding:0;" data-close-cart-drawer aria-label="{{ 'accessibility.close_drawer' | t }}">
        {% render 'aero-icon', icon: 'close' %}
      </button>
    </div>

    <div class="aero-shipping-meter">
      <div data-shipping-text>{{ 'cart.free_shipping_progress' | t: amount: '$35.00' }}</div>
      <div class="aero-shipping-track">
        <div class="aero-shipping-fill" data-shipping-fill></div>
      </div>
    </div>

    <div class="aero-drawer__body">
      <div data-cart-items style="display:flex;flex-direction:column;gap:0.75rem;"></div>

      <div data-cart-empty hidden style="text-align:center;padding:2.5rem 1rem;">
        <span class="swatch-aero-resin swatch-aero-resin--xl" style="--resin-color: var(--swatch-cyan);margin-inline:auto;margin-bottom:1rem;"></span>
        <h3 style="margin-bottom:0.4rem;">{{ 'cart.empty' | t }}</h3>
        <p class="aero-muted" style="font-size:0.9rem;">Stop pinching your herb and keep one tucked right inside your grinder.</p>
        <a href="/products/terpscoop-2pk" class="btn-aero-gel btn-aero-gel--sm">
          {{ 'cart.empty_cta' | t }}
        </a>
      </div>

      {%- assign upsell_product = settings.cart_upsell_product -%}
      {%- if upsell_product != blank and upsell_product.available -%}
        <div class="aero-glass" style="padding:0.85rem;border-radius:18px;margin-top:auto;">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;">
            <div>
              <span class="aero-mono-tag">QUICK TOP-UP</span>
              <div style="font-weight:700;font-size:0.9rem;">{{ upsell_product.title }}</div>
              <div class="aero-muted" style="font-size:0.82rem;">{{ upsell_product.price | money }}</div>
            </div>
            {% form 'product', upsell_product, data-ajax-cart-form: 'true' %}
              <input type="hidden" name="id" value="{{ upsell_product.selected_or_first_available_variant.id }}">
              <button type="submit" class="btn-aero-sky btn-aero-gel--xs">+ Add</button>
            {% endform %}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="aero-drawer__footer" data-cart-footer>
      <div class="aero-field" style="margin-bottom:0;">
        <label for="CartDrawerNote" style="font-size:0.76rem;">{{ 'cart.note_label' | t }}</label>
        <textarea
          id="CartDrawerNote"
          class="aero-textarea"
          rows="2"
          placeholder="{{ 'cart.note_placeholder' | t }}"
          data-cart-note
        >{{ cart.note }}</textarea>
      </div>

      <div class="aero-drawer__subtotal">
        <span>{{ 'cart.subtotal' | t }}</span>
        <span class="aero-mono-tag" style="font-size:1.15rem;color:var(--aero-ink);" data-cart-subtotal>{{ cart.total_price | money }}</span>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1.4fr;gap:0.6rem;">
        <a href="{{ routes.cart_url }}" class="btn-aero-ghost btn-aero-gel--sm">{{ 'cart.view_cart' | t }}</a>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn-aero-gel btn-aero-gel--sm btn-aero-gel--full">
            {{ 'cart.checkout' | t }}
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Aero Cart Drawer",
  "settings": []
}
{% endschema %}

