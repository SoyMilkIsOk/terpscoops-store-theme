<section class="aero-section">
  <div class="page-width">
    <div class="aero-section-header">
      <div class="aero-section-header__copy">
        <span class="aero-mono-tag">HEAVYWEIGHT TEES &amp; EMBROIDERED HEADWEAR</span>
        <h2>{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.subheading | escape }}</p>
      </div>
      <a href="{{ routes.collections_url }}/merch" class="btn-aero-ghost btn-aero-gel--sm">
        <span>Shop All Merch</span>
        {% render 'aero-icon', icon: 'arrow-right' %}
      </a>
    </div>

    {%- assign merch_collection = section.settings.collection -%}
    {%- if merch_collection == blank -%}
      {%- assign merch_collection = collections['merch'] -%}
    {%- endif -%}
    <div class="aero-grid-4">
      {%- if merch_collection != blank and merch_collection.products_count > 0 -%}
        {%- for product in merch_collection.products limit: 4 -%}
          {% render 'product-card-aero', product: product, theme_variant: 'day', show_swatches: false %}
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_merch = 'terpscoop-flower-embroidered-dad-hat,terpmetrix-heavyweight-t-shirt,terps-next-door-heavyweight-t-shirt,terpscoops-lightweight-t-shirt' | split: ',' -%}
        {%- for handle in fallback_merch -%}
          {%- assign prod = all_products[handle] -%}
          {%- if prod != blank and prod.id != blank -%}
            {% render 'product-card-aero', product: prod, theme_variant: 'day', show_swatches: false %}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Terp Merch Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Terp Merch. 6.1 oz Garment-Dyed & Embroidered."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Made-to-order heavyweight 100% ring-spun cotton tees and low-profile embroidered chino twill hats to reduce overproduction."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Merch Collection"
    }
  ],
  "presets": [
    {
      "name": "Terp Merch Grid"
    }
  ]
}
{% endschema %}

