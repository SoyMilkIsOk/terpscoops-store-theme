<section class="aero-section aero-section--tight">
  <div class="page-width">
    <div class="aero-glass aero-window" style="padding:1.5rem 1.75rem;margin-bottom:1.75rem;">
      <h1>{{ 'general.search' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;gap:0.65rem;flex-wrap:wrap;">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search_placeholder' | t }}"
          class="aero-input"
          style="flex:1;min-width:220px;"
          aria-label="{{ 'general.search' | t }}"
        >
        <button type="submit" class="btn-aero-gel btn-aero-gel--sm">{{ 'general.search' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {% paginate search.results by 24 %}
        {%- if search.results_count > 0 -%}
          <div class="aero-grid-4">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card-aero', product: item, show_swatches: true %}
              {%- else -%}
                <article class="aero-glass" style="padding:1.25rem;">
                  <span class="aero-mono-tag">{{ item.object_type | upcase }}</span>
                  <h3 style="margin-top:0.35rem;"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  <p class="aero-muted" style="font-size:0.9rem;">{{ item.content | strip_html | truncate: 110 }}</p>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="aero-glass" style="padding:2.5rem;text-align:center;">
            <h3>No results found for "{{ search.terms | escape }}"</h3>
            <a href="{{ routes.collections_url }}/shop-terpscoops" class="btn-aero-sky btn-aero-gel--sm">Browse All Terpscoops</a>
          </div>
        {%- endif -%}
      {% endpaginate %}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Aero Search Results",
  "settings": []
}
{% endschema %}

