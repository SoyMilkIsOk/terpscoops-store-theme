<section class="aero-section">
  <div class="page-width">
    <div class="aero-glass aero-window" style="max-width:620px;margin-inline:auto;text-align:center;">
      <div class="aero-window__bar">
        <span class="aero-window__dots" aria-hidden="true">
          <span class="aero-window__dot aero-window__dot--pink"></span>
          <span class="aero-window__dot aero-window__dot--cyan"></span>
        </span>
      </div>
      <div style="padding:3rem 2rem;">
        <span class="swatch-aero-resin swatch-aero-resin--xl" style="--resin-color:var(--swatch-pink);margin-inline:auto;margin-bottom:1rem;"></span>
        <h1>Page Not Found</h1>
        <p class="aero-muted">That page isn't inside this grinder chamber. Jump back to the storefront below.</p>
        <div style="display:flex;justify-content:center;gap:0.75rem;flex-wrap:wrap;">
          <a href="{{ routes.root_url }}" class="btn-aero-gel">Back to Home</a>
          <a href="{{ routes.collections_url }}/shop-terpscoops" class="btn-aero-sky">Shop All Scoops</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aero 404 Page",
  "settings": []
}
{% endschema %}

