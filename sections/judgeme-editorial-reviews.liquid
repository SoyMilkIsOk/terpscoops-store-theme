<section class="aero-section aero-section--tight">
  <div class="page-width">
    <div class="aero-section-header">
      <div class="aero-section-header__copy">
        <h2>{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.subheading | escape }}</p>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="aero-grid-3">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="aero-glass" style="padding:1.5rem;grid-column:1 / -1;" {{ block.shopify_attributes }}>
              {% render block %}
            </div>
          {%- else -%}
            <article class="aero-glass aero-review-card" {{ block.shopify_attributes }}>
              <span class="aero-stars" aria-label="5 stars">
                {%- for i in (1..5) -%}{% render 'aero-icon', icon: 'star' %}{%- endfor -%}
              </span>
              <p class="aero-review-card__quote">"{{ block.settings.quote | escape }}"</p>
              <span class="aero-review-card__author">— {{ block.settings.author | escape }}</span>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Aero Community Reviews",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Let customers speak for us."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real community reviews from daily Terpscoops owners across the country."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "product_tag",
          "label": "Product Tag",
          "default": "Terpscoop 2pk"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The terp scoop is the greatest thing ever invented. Perfect size for my bowls and don't need to worry about stinky fingers or bits getting stuck under my nails."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer Name",
          "default": "Verified Scoop Owner"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aero Community Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "product_tag": "Terpscoop 2pk",
            "quote": "The terp scoop is the greatest thing ever invented. Perfect size for my bowls and don't need to worry about stinky fingers or bits getting stuck under my nails. Terp scoops are a stoner girl's best friend.",
            "author": "Boulder / Online Review"
          }
        },
        {
          "type": "review",
          "settings": {
            "product_tag": "Terpscoop 8pk",
            "quote": "Got these for me and my friends, and I got us different colors like the power rangers. They love it when the scoops assemble. Try it sometime 🌈.",
            "author": "Rainbow 8-Pack Owner"
          }
        },
        {
          "type": "review",
          "settings": {
            "product_tag": "Terpscoop 4pk",
            "quote": "Honestly my favorite way to pack a bowl now and you can make the perfect rounded scoop :) very pleased. Really changing the game.",
            "author": "Verified Customer"
          }
        }
      ]
    }
  ]
}
{% endschema %}

