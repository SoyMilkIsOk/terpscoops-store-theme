{%- case icon -%}
  {%- when 'scoop' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M16.5 3.5a4.5 4.5 0 0 1 4 4c0 2.5-2 4.5-4.5 4.5-1 0-1.9-.3-2.7-.9L5.4 19a1.8 1.8 0 0 1-2.5-2.5l7.9-7.9c-.6-.8-.9-1.7-.9-2.7A4.5 4.5 0 0 1 16.5 3.5Z"/>
    </svg>
  {%- when 'grinder' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <ellipse cx="12" cy="7" rx="8" ry="3.5"/>
      <path d="M4 7v10c0 1.9 3.6 3.5 8 3.5s8-1.6 8-3.5V7"/>
      <path d="M4 12c0 1.9 3.6 3.5 8 3.5s8-1.6 8-3.5"/>
    </svg>
  {%- when 'droplet' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2.7 6.3 9.7a7.5 7.5 0 1 0 11.4 0L12 2.7Z"/>
      <path d="M9.5 14.5a3 3 0 0 0 3 3"/>
    </svg>
  {%- when 'sparkles' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3l1.7 4.7L18.5 9.5l-4.8 1.8L12 16l-1.7-4.7L5.5 9.5l4.8-1.8L12 3Z"/>
      <path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9L19 15Z"/>
    </svg>
  {%- when 'mountain' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 19l6.5-11 4.2 6.8L16.5 11 21 19H3Z"/>
      <path d="M8.5 12l1.8 1.2 1.8-1.2"/>
    </svg>
  {%- when 'shield' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 2l7 3.5v6c0 5-3.4 9.1-7 10.5-3.6-1.4-7-5.5-7-10.5v-6L12 2Z"/>
      <path d="M9 12l2 2 4-4"/>
    </svg>
  {%- when 'cart' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="9" cy="20" r="1.5"/>
      <circle cx="17" cy="20" r="1.5"/>
      <path d="M3 4h2.2l2.4 10.5a2 2 0 0 0 2 1.5h7.6a2 2 0 0 0 2-1.5L21 7H6"/>
    </svg>
  {%- when 'star' -%}
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2.2l2.9 6.2 6.8.9-5 4.8 1.2 6.8L12 17.6l-5.9 3.3 1.2-6.8-5-4.8 6.8-.9L12 2.2Z"/>
    </svg>
  {%- when 'check' -%}
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
    </svg>
  {%- when 'close' -%}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18"/>
    </svg>
  {%- when 'arrow-right' -%}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 6l6 6-6 6"/>
    </svg>
  {%- when 'instagram' -%}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
    </svg>
  {%- when 'menu' -%}
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16"/>
    </svg>
  {%- when 'search' -%}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"/>
      <path d="M20 20l-3.5-3.5"/>
    </svg>
{%- endcase -%}

