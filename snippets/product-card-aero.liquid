{%- comment -%}
  Frutiger Aero Product Card
  Params:
    - product: Shopify product object (required)
    - theme_variant: 'day' | 'chrome' (optional, default 'day')
    - show_swatches: boolean (optional, default true)
{%- endcomment -%}

{%- liquid
  assign card_variant = theme_variant | default: 'day'
  assign display_swatches = show_swatches | default: true
  assign handle_lower = product.handle | downcase
  if handle_lower contains 'stainless' or handle_lower contains 'titanium' or handle_lower contains 'silver'
    if theme_variant == 'chrome'
      assign card_variant = 'chrome'
    else
      assign card_variant = 'metal-light'
    endif
  endif

  assign is_color_pack = false
  if handle_lower contains '2pk' or handle_lower contains '4pk' or handle_lower contains '8pk'
    assign is_color_pack = true
  endif

  assign badge_label = ''
  if product.available == false
    assign badge_label = 'Sold Out'
  endif
-%}

<article class="aero-product-card{% if card_variant == 'chrome' %} aero-product-card--chrome{% elsif card_variant == 'metal-light' %} aero-product-card--metal-light{% else %} aero-glass{% endif %}">
  <a href="{{ product.url }}" class="aero-product-card__media-link" aria-label="{{ product.title | escape }}">
    <div class="aero-product-card__media">
      {%- if badge_label != blank -%}
        <span class="aero-pill aero-pill--muted aero-product-card__badge">{{ badge_label }}</span>
      {%- endif -%}

      {%- if product.featured_media != blank -%}
        <img
          src="{{ product.featured_media | image_url: width: 720 }}"
          srcset="
            {{ product.featured_media | image_url: width: 360 }} 360w,
            {{ product.featured_media | image_url: width: 540 }} 540w,
            {{ product.featured_media | image_url: width: 720 }} 720w
          "
          sizes="(min-width: 990px) 25vw, 50vw"
          alt="{{ product.featured_media.alt | default: product.title | escape }}"
          loading="lazy"
          width="{{ product.featured_media.width }}"
          height="{{ product.featured_media.height }}"
          class="aero-product-card__img aero-product-card__img--primary"
        >
        {%- if product.media[1] != blank -%}
          <img
            src="{{ product.media[1] | image_url: width: 720 }}"
            alt="{{ product.media[1].alt | default: product.title | escape }}"
            loading="lazy"
            width="{{ product.media[1].width }}"
            height="{{ product.media[1].height }}"
            class="aero-product-card__img aero-product-card__img--secondary"
          >
        {%- endif -%}
      {%- else -%}
        <div class="aero-product-card__placeholder">
          {% render 'aero-icon', icon: 'scoop' %}
        </div>
      {%- endif -%}
    </div>
  </a>

  <div class="aero-product-card__body">
    <h3 class="aero-product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
      {{ product.metafields.judgeme.badge }}
    </div>

    {%- if display_swatches -%}
      {%- if is_color_pack -%}
        <div class="aero-product-card__swatches" aria-label="Available colors">
          <span
            class="swatch-aero-resin swatch-aero-resin--mini swatch-aero-resin--rainbow"
            title="You Pick"
          ></span>
          {%- assign swatch_colors = 'Pink,Red,Orange,Yellow,Green,Cyan,Blue,Purple' | split: ',' -%}
          {%- for color_name in swatch_colors -%}
            {%- assign color_slug = color_name | downcase -%}
            <span
              class="swatch-aero-resin swatch-aero-resin--mini"
              style="--resin-color: var(--swatch-{{ color_slug }});"
              title="{{ color_name }}"
            ></span>
          {%- endfor -%}
        </div>
      {%- elsif product.options_by_name['Color'].values.size > 0 -%}
        <div class="aero-product-card__swatches" aria-label="Available colors">
          {%- for color_val in product.options_by_name['Color'].values -%}
            {% render 'merch-color-swatch', color_name: color_val %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    <div class="aero-product-card__footer">
      <div class="aero-product-card__price">
        {%- if product.price_varies -%}
          <span class="aero-price-from">From</span>
        {%- endif -%}
        <span class="aero-price-value">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <s class="aero-price-compare">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
      </div>

      {%- if product.available -%}
        {%- if is_color_pack -%}
          <a href="{{ product.url }}" class="btn-aero-gel btn-aero-gel--sm">
            Shop
          </a>
        {%- elsif product.has_only_default_variant -%}
          {% form 'product', product, data-ajax-cart-form: 'true' %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="btn-aero-gel btn-aero-gel--sm">
              + Add
            </button>
          {% endform %}
        {%- else -%}
          <a href="{{ product.url }}" class="btn-aero-sky btn-aero-gel--sm">
            Shop
          </a>
        {%- endif -%}
      {%- else -%}
        <a href="{{ product.url }}" class="btn-aero-chrome btn-aero-gel--sm">
          Notify Me
        </a>
      {%- endif -%}
    </div>
  </div>
</article>

