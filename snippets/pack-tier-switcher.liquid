{%- comment -%}
  Pack-Tier Switcher linking 2pk ($4.20), 4pk ($8.00), and 8pk ($15.00)
  Params:
    - current_handle: string
{%- endcomment -%}

{%- liquid
  assign p2 = all_products['terpscoop-2pk']
  assign p4 = all_products['terpscoop-4pk']
  assign p8 = all_products['terpscoop-8pk']
  assign active_handle = current_handle | default: product.handle
-%}

<div class="aero-pack-switcher" role="navigation" aria-label="Choose pack size">
  <div class="aero-pack-switcher__label">
    <span class="aero-mono-tag">PACK SIZE &amp; VALUE</span>
    <span class="aero-pack-switcher__hint">Bundle more &amp; save per scoop</span>
  </div>
  <div class="aero-pack-switcher__grid">
    <a
      href="{{ p2.url | default: '/products/terpscoop-2pk' }}"
      class="aero-pack-tier{% if active_handle == 'terpscoop-2pk' %} is-active{% endif %}"
    >
      <span class="aero-pack-tier__badge">Iconic</span>
      <strong class="aero-pack-tier__name">2-Pack</strong>
      <span class="aero-pack-tier__price">{{ p2.price | default: 420 | money }}</span>
      <span class="aero-pack-tier__unit">$2.10 / scoop</span>
    </a>

    <a
      href="{{ p4.url | default: '/products/terpscoop-4pk' }}"
      class="aero-pack-tier{% if active_handle == 'terpscoop-4pk' %} is-active{% endif %}"
    >
      <span class="aero-pack-tier__badge">Share Pack</span>
      <strong class="aero-pack-tier__name">4-Pack</strong>
      <span class="aero-pack-tier__price">{{ p4.price | default: 800 | money }}</span>
      <span class="aero-pack-tier__unit">$2.00 / scoop</span>
    </a>

    <a
      href="{{ p8.url | default: '/products/terpscoop-8pk' }}"
      class="aero-pack-tier{% if active_handle == 'terpscoop-8pk' %} is-active{% endif %}"
    >
      <span class="aero-pack-tier__badge aero-pack-tier__badge--best">Best Value</span>
      <strong class="aero-pack-tier__name">8-Pack</strong>
      <span class="aero-pack-tier__price">{{ p8.price | default: 1500 | money }}</span>
      <span class="aero-pack-tier__unit">$1.87 / scoop</span>
    </a>
  </div>
</div>

